# Android / Gradle
*.iml
.gradle/
local.properties
.idea/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.keystore
# Firebase config: identifies a specific project and carries an API key.
# The glob catches browser re-downloads saved as 'google-services (1).json'.
# NB: a trailing comment on a pattern line does NOT work — gitignore treats
# the whole line as the pattern, which is how this file came to be committed.
google-services*.json

# Encoder assets, derived from a third-party model. Regenerate with:
#   tools/eval/fetch_model.sh && python tools/model/prepare_assets.py --model-dir tools/eval/model
app/src/main/assets/models/

# Python corpus tooling
.venv/
__pycache__/
*.pyc

# Generated corpus — regenerate with tools/corpus/generate_corpus.py
tools/corpus/corpus/
tools/corpus/results/
tools/corpus/ground_truth.json

# Encoder weights — fetched by tools/eval/fetch_model.sh, not committed
tools/eval/model/

# Third-party PDFs fetched for testing — other people's documents, not ours to
# redistribute. Rebuild with tools/corpus/fetch_real_pdfs.py
tools/corpus/real/

# Kotlin build tooling
.kotlin/

# Release signing credentials. The keystore itself lives outside the repo;
# this file only points at it and carries its passwords.
keystore.properties
*.jks
*.keystore

# RevenueCat API key. A Test Store key unlocks only a sandbox, but it is still
# an account credential and this repo is public.
revenuecat.properties
